{
  "name": "wizbot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "workspaces/*"
  ],
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pm2 start ecosystem.config.js",
    "list": "pm2 list",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "lint": "pnpm -r run lint",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:generate": "pnpm --filter @wizbot/api exec prisma generate",
    "prisma:migrate": "pnpm --filter @wizbot/api exec prisma migrate dev",
    "prisma:deploy": "pnpm --filter @wizbot/api exec prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "devDependencies": {
    "@wizbot/eslint-config": "workspace:^",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.8.2"
  }
}
