# MySQL 접속 URL (schema.prisma의 env("DATABASE_URL"))
DATABASE_URL="mysql://user:password@localhost:3306/wizbot"

# 치지직 Open API (https://developers.chzzk.naver.com)
CHZZK_ID=""               # Client ID
CHZZK_SECRET=""           # Client Secret
CHZZK_BOT_CHANNEL_ID=""   # 봇 계정의 채널 ID (봇 자신의 채팅 무시용)

# 사이트 공개 URL (OAuth redirect: ${PUBLIC_SITE_URL}/login/auth)
PUBLIC_SITE_URL="http://localhost:3001"

# SMTP 폴백 (#215) — 어드민 「알림 설정」의 DB 설정이 없을 때 사용
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER=""            # 보내는 주소 (예: no-reply@example.com)

# 세션 JWT 서명 키 — apps/web의 JWT_SECRET과 동일한 값이어야 함
JWT_SECRET=""
# 내부 서비스(챗봇 워커) 인증 토큰 (예: openssl rand -hex 32) — apps/chatbot과 동일한 값
INTERNAL_API_TOKEN=""
# 리슨 포트 (기본 3002)
# PORT=3002
