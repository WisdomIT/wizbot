// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ChatbotPermission {
  STREAMER
  MANAGER
  VIEWER
}

enum SongStatus {
  PLAYING
  PAUSED
  STOPPED
}

/// 자막 표시 방식 (#5) — 계속 띄울지, 곡이 바뀔 때 잠깐만 보여줄지
enum SongOverlayMode {
  ALWAYS
  TIMED
}

/// 소리를 내보내는 경로 (#5 2단계) — 지정된 소스만 재생한다
enum SongSourceType {
  NONE
  OBS
  ELECTRON
}

/// 신청된 곡의 최종 상태 (#5/#6 — 재생 여부와 무관하게 전부 기록)
enum SongHistoryStatus {
  PLAYED    // 끝까지 재생됨
  SKIPPED   // 재생 중 중단됨
  CANCELED  // 재생 전 삭제됨
  FAILED    // 재생 시도했으나 실패
}

/// 사용 신청 처리 상태 (#96)
enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 스트리머 테마의 라이트/다크 (#77)
enum ThemeScheme {
  SYSTEM
  LIGHT
  DARK
}

model Whitelist {
  id         Int    @id @default(autoincrement())
  nickname   String @db.VarChar(50)
  channelId  String @unique @db.VarChar(32)
}

/// 사이트 내 사용 신청 (#96). 치지직 OAuth 로 본인 확인된 채널만 만들어진다.
/// 화이트리스트와 독립이다 — 승인이 화이트리스트 등록을 일으키지만, 해제해도 이 레코드는 남는다.
model SignupApplication {
  id              Int          @id @default(autoincrement())
  channelId       String       @unique @db.VarChar(32)
  channelName     String       @db.VarChar(50)
  channelImageUrl String?      @db.Text
  /// 신청자가 적는 사유 (선택)
  reason          String?      @db.VarChar(500)
  status          SignupStatus @default(PENDING)
  rejectReason    String?      @db.VarChar(500)
  createdAt       DateTime     @default(now()) @db.DateTime(6)
  updatedAt       DateTime     @updatedAt @db.DateTime(6)
  processedAt     DateTime?    @db.DateTime(6)
  processedById   Int?
  processedBy     Admin?       @relation(fields: [processedById], references: [id], onDelete: SetNull)

  /// 신청 시점의 OAuth 토큰 (#151). 대기 중에도 갱신해 승인 즉시 봇이 붙게 한다.
  /// 거절·30일 경과·갱신 실패 시 지운다. 승인 시 OAuthCredential 로 옮기고 지운다.
  accessToken      String?   @db.Text
  refreshToken     String?   @db.Text
  tokenType        String?   @db.VarChar(20)
  tokenExpiresAt   DateTime? @db.DateTime(0)
  tokenRefreshedAt DateTime? @db.DateTime(0)
  /// 승인 후 스트리머가 처음 로그인한 시각 — 찍히면 채팅 안내를 멈춘다
  acknowledgedAt   DateTime? @db.DateTime(6)

  @@index([status, createdAt])
}

/// 공지사항 (#206). 어드민이 작성하고 랜딩·스트리머 콘솔·시청자 페이지에 마크다운(GFM)으로 표시된다.
model Notice {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  /// 마크다운 본문
  body      String   @db.MediumText
  /// 팝업 공지 — 스트리머 콘솔 첫 접속 시 모달로 (확인 기록은 다음 PR)
  popup     Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @updatedAt @db.DateTime(6)

  reads NoticeRead[]
}

/// 공지 읽음 기록 (#206). 팝업 공지의 "확인하면 다시 안 뜸"과 사이드바 새 글 표시를 겸한다.
model NoticeRead {
  noticeId Int
  userId   Int
  readAt   DateTime @default(now()) @db.DateTime(6)

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
}

/// 설정 도우미 에이전트 전역 설정 (#35) — 재배포 없이 바꾸도록 DB(어드민 페이지)로 관리한다.
/// 프로바이더(키·모델)는 AgentProvider 목록, 한도는 AgentLimit 규칙으로 분리됐다.
model AgentSettings {
  id               Int      @id @default(1)
  enabled          Boolean  @default(false)
  /// 프로바이더의 네이티브 웹 검색(서버 측) 사용 — 지원하는 프로바이더에서만 실린다
  webSearchEnabled Boolean  @default(false)
  /// 스트리머가 자기 대화를 목록에서 지울 수 있는지 — 기본 꺼짐, 운영자의 결정 (pelican #8)
  allowConversationDelete Boolean @default(false)
  updatedAt        DateTime @updatedAt @db.DateTime(6)
}

/// LLM 프로바이더 — 순서 있는 목록 (pelican-concierge #89 방식). 1순위가 답을 멈추면
/// (크레딧 소진·쿼터·장애) 다음 항목이 이어받는다. 쉬는(cooldown) 상태는 메모리에만 둔다 —
/// 장애 조치는 운영자의 설정을 바꾸는 일이 아니다.
model AgentProvider {
  id        Int               @id @default(autoincrement())
  /// 낮을수록 먼저 시도
  priority  Int
  /// 표시명 — 사용량 내역에 이름으로 남는다 (항목을 지워도 내역이 읽히도록 id 가 아니라 이름)
  name      String            @db.VarChar(60)
  kind      AgentProviderKind
  /// 로컬 OpenAI 호환 엔드포인트는 비울 수 있다
  apiKey    String            @default("") @db.VarChar(255)
  /// OPENAI_COMPAT 전용 — 엔드포인트 주소
  baseUrl   String?           @db.VarChar(255)
  model     String            @db.VarChar(100)
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.DateTime(6)
  updatedAt DateTime          @updatedAt @db.DateTime(6)
}

enum AgentProviderKind {
  ANTHROPIC
  OPENAI
  GEMINI
  /// 로컬 LLM 등 OpenAI 호환 엔드포인트
  OPENAI_COMPAT
}

/// 사용 한도 규칙 (pelican-concierge #4 의 3축) — 기준 × 범위 × 주기. 여러 규칙은 전부(AND) 적용되고,
/// 하나라도 초과하면 차단된다. GLOBAL 규칙 초과는 전체 차단.
model AgentLimit {
  id        Int              @id @default(autoincrement())
  metric    AgentLimitMetric
  scope     AgentLimitScope
  period    AgentLimitPeriod
  amount    Int
  createdAt DateTime         @default(now()) @db.DateTime(6)
}

enum AgentLimitMetric {
  /// input + output 토큰 합
  TOKENS
  /// 채팅(요청) 수
  MESSAGES
}

enum AgentLimitScope {
  STREAMER
  GLOBAL
}

enum AgentLimitPeriod {
  HOUR
  DAY
  WEEK
  MONTH
}

/// 에이전트 대화 (#35). replica 가 여러 개라 서버 메모리에 두지 않고 DB 로 잇는다.
model AgentConversation {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String         @default("새 대화") @db.VarChar(200)
  /// soft delete (pelican #8) — 스트리머 목록에서만 사라지고 어드민 로그·사용량 집계에는 남는다
  deletedAt DateTime?      @db.DateTime(6)
  createdAt DateTime       @default(now()) @db.DateTime(6)
  updatedAt DateTime       @updatedAt @db.DateTime(6)
  messages  AgentMessage[]
  pendingActions AgentPendingAction[]

  @@index([userId, updatedAt])
}

/// 승인 카드 (#35 조정 2, pelican tool_confirmation 이식). 파괴적 tool 은 모델이 부르는 순간
/// 턴이 멈추고 이 행이 생긴다 — 실행 경로는 승인 mutation 뿐이라 모델이 뭐라 하든 시스템이 막는다.
/// native 에는 같은 턴을 재개하기 위한 어댑터별 상태(메시지·response id 등)가 담긴다.
model AgentPendingAction {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// 재개는 같은 프로바이더로만 가능하다 (네이티브 상태가 어댑터별이므로)
  providerId     Int
  toolUseId      String            @db.VarChar(80)
  tool           String            @db.VarChar(60)
  input          Json
  /// 화면 카드 내용 {title, lines}
  card           Json
  native         Json
  status         AgentActionStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @db.DateTime(6)
  expiresAt      DateTime          @db.DateTime(6)
  resolvedAt     DateTime?         @db.DateTime(6)

  @@index([conversationId, status])
}

enum AgentActionStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

model AgentMessage {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role           String            @db.VarChar(12)
  /// Anthropic MessageParam.content 그대로 (텍스트·tool_use·tool_result 블록 배열)
  content        Json
  createdAt      DateTime          @default(now()) @db.DateTime(6)

  @@index([conversationId])
}

/// 요청 1회 = 1행. 한도 계산과 어드민 사용량 통계의 근거.
/// provider·entryName: 어느 항목으로 청구됐는가 — 장애 조치 뒤 비용 내역이 거짓말하지 않도록
model AgentUsage {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  Int?
  provider        String   @default("ANTHROPIC") @db.VarChar(20)
  entryName       String?  @db.VarChar(60)
  model           String   @db.VarChar(100)
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int      @default(0)
  createdAt       DateTime @default(now()) @db.DateTime(6)

  @@index([userId, createdAt])
  //  GLOBAL 한도는 userId 없이 기간으로만 조회한다
  @@index([createdAt])
}

/// SMTP 설정 (#215) — 단일 행(id=1). 재배포 없이 바꾸도록 DB(어드민 페이지)로 관리한다.
/// 행이 없으면 SMTP_* 환경변수로 폴백 — 관리자 로그인이 패스코드 메일에 의존하므로 env 가 잠금 방지 탈출구다.
model MailSettings {
  id        Int      @id @default(1)
  host      String   @db.VarChar(255)
  port      Int      @default(465)
  user      String   @db.VarChar(255)
  pass      String   @db.VarChar(255)
  sender    String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @db.DateTime(6)
}

/// 운영 알림용 디스코드 웹훅 (#207). 종류별로 채널을 나눠 받도록 엔드포인트를 따로 두고,
/// 재배포 없이 바꾸도록 환경변수가 아니라 DB(어드민 페이지)로 관리한다.
model DiscordWebhook {
  kind      NotifyKind @id
  url       String     @db.VarChar(300)
  enabled   Boolean    @default(true)
  updatedAt DateTime   @updatedAt @db.DateTime(6)
}

enum NotifyKind {
  /// 네이버 봇 세션 만료 (#9)
  SESSION_EXPIRED
  /// 신규 사용 신청 (#96)
  SIGNUP
  /// 카페 봇 가입 요청 (#9)
  CAFE_JOIN
  /// 문의사항 등록·추가 (#206)
  INQUIRY
  /// 워커·API 의 심각한 오류 — 발생처는 앞으로 넓힌다
  ERROR
}

/// 문의사항 (#206 3/3). 스트리머가 쓰고 어드민이 답한다 — 본문은 마크다운(GFM), 메시지 스레드.
model Inquiry {
  id             Int           @id @default(autoincrement())
  userId         Int
  title          String        @db.VarChar(200)
  /// OPEN = 답변 대기(스트리머가 마지막), ANSWERED = 답변 완료(어드민이 마지막)
  status         InquiryStatus @default(OPEN)
  /// 새 글 표시용 — 각자 스레드를 연 마지막 시각과 상대 메시지 시각을 비교한다
  streamerReadAt DateTime?     @db.DateTime(6)
  adminReadAt    DateTime?     @db.DateTime(6)
  createdAt      DateTime      @default(now()) @db.DateTime(6)
  updatedAt      DateTime      @updatedAt @db.DateTime(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages InquiryMessage[]

  @@index([userId, id])
}

enum InquiryStatus {
  OPEN
  ANSWERED
}

model InquiryMessage {
  id        Int           @id @default(autoincrement())
  inquiryId Int
  author    InquiryAuthor
  body      String        @db.MediumText
  createdAt DateTime      @default(now()) @db.DateTime(6)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, id])
}

enum InquiryAuthor {
  STREAMER
  ADMIN
}

/// 설정 변경 감사 로그 (#175). 스트리머 스코프의 모든 변경(mutation)을 남긴다 — 본인이든 어드민 대행(#71)이든.
/// 어드민이 남의 콘솔을 몰래 바꿀 수 없게 하는 투명성 장치라, 스트리머 본인도 자기 기록을 본다.
model AuditLog {
  id        Int        @id @default(autoincrement())
  /// 대상 스트리머
  userId    Int
  actorType AuditActor
  /// STREAMER 면 userId, ADMIN 이면 Admin.id. CHATBOT 은 계정 id 가 없어 null
  actorId   Int?
  /// CHATBOT — 채팅으로 호출한 사람 (닉네임 · 치지직 채널 id)
  actorName String?    @db.VarChar(120)
  /// tRPC 경로 (command.create 등)
  procedure String     @db.VarChar(100)
  /// 정리된 입력 — 토큰류 키 제거·대용량 값 절단 (lib/audit.ts)
  input     Json?
  createdAt DateTime   @default(now()) @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
}

enum AuditActor {
  STREAMER
  ADMIN
  /// 챗봇 명령(!추가 등)으로 바꾼 경우 — 호출한 채팅 계정을 actorName 에 남긴다
  CHATBOT
  /// 설정 도우미 에이전트 (#35) — 스트리머의 지시로 에이전트가 수행한 변경
  AGENT
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique @db.VarChar(250)

  passcode AdminLogin?
  processedApplications SignupApplication[]
}

model AdminLogin {
  adminId  Int    @unique
  passcode String @db.VarChar(6)
  createdAt DateTime @default(now()) @db.DateTime(6)

  admin    Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model User {
  id                Int      @id @default(autoincrement())
  channelId         String   @unique @db.VarChar(32)
  channelImageUrl   String?  @db.Text
  channelName       String   @db.VarChar(50)
  hidden            Boolean  @db.TinyInt @default(false)

  // OAuth credentials relationship (분리된 OAuth 정보)
  oauth             OAuthCredential?

  // Relations
  userSetting       UserSetting?
  userTheme         UserTheme?
  userShortcuts     UserShortcut[]
  echoCommands      ChatbotEchoCommand[]
  functionCommands  ChatbotFunctionCommand[]
  repeatCommands    ChatbotRepeat[]
  songs             Song[]
  songHistories     SongHistory[]
  songPlayback      SongPlayback?
  playlists         SongFavorite[]
  cafeIntegration   CafeIntegration?
  auditLogs         AuditLog[]
  agentConversations AgentConversation[]
  agentUsages       AgentUsage[]
  noticeReads       NoticeRead[]
  inquiries         Inquiry[]
}

/// 스트리머 테마 (#77). 시청자 페이지·콘솔·앱·OBS 오버레이에 적용된다. 행이 없으면 서비스 기본.
model UserTheme {
  id              Int         @id @default(autoincrement())
  userId          Int         @unique
  /// #rrggbb. null 이면 서비스 기본색
  /// 강조 색 — 활성 메뉴·버튼·명령어 배경. 컬럼명은 토큰명(--primary)을 따른다
  primaryColor    String?     @db.VarChar(7)
  backgroundColor String?     @db.VarChar(7)
  sidebarColor    String?     @db.VarChar(7)
  colorScheme     ThemeScheme @default(SYSTEM)
  /// packages/shared/src/lib/theme.ts 의 THEME_FONTS 키
  fontKey         String      @default("suit") @db.VarChar(32)
  updatedAt       DateTime    @updatedAt @db.DateTime(6)

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSetting {
  id                    Int     @id @default(autoincrement())
  userId                Int     @unique                     // 각 유저당 한 개의 설정정보
  chatbotActive         Boolean @db.TinyInt @default(true)  // 챗봇 사용 여부
  songActive            Boolean @db.TinyInt @default(true)  // 노래 기능 사용 여부
  songKeyboardShortcut  Boolean @db.TinyInt @default(true)  // 노래 단축키 사용 여부
  /// 전역 단축키 조합 (Electron accelerator). null 이면 기본값 (#85)
  songShortcutPlayPause String? @db.VarChar(64)
  songShortcutStop      String? @db.VarChar(64)
  songShortcutNext      String? @db.VarChar(64)
  chatbotDefaultRepeat  Int     @db.Int @default(300)       // 챗봇 기본 반복 시간(초)
  songOneRequestPerUser Boolean @db.TinyInt @default(false) // 1인당 대기열 1곡 제한
  songAutoPlayFromDefault Boolean @db.TinyInt @default(false) // 다음 곡 없으면 대표 즐겨찾기에서 랜덤 재생
  songHistoryPublic     Boolean @db.TinyInt @default(false) // 시청자에게 재생 기록 공개
  songMaxDurationSeconds Int    @db.Int @default(600)      // 신청 가능한 최대 길이(초)
  songMaxQueueLength    Int     @db.Int @default(30)        // 대기열 최대 곡 수
  songSourceType        SongSourceType @default(OBS)        // 소리를 내보낼 경로
  /// OBS 재생 페이지 토큰 (URL 에 노출되므로 재발급 가능해야 한다)
  songSourceToken       String? @db.VarChar(64)
  /// 읽기 전용 토큰 (현재 재생 페이지가 자막을 함께 표시하므로 미사용 — 별도 오버레이가 필요해지면 사용)
  songOverlayToken      String? @db.VarChar(64)
  songOverlayMode       SongOverlayMode @default(ALWAYS) // 자막 표시 방식
  songOverlayDurationSeconds Int @db.Int @default(10)    // TIMED 일 때 표시 시간(초)
  
  user              User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserShortcut {
  id       Int    @id @default(autoincrement())
  userId   Int
  name     String @db.VarChar(20)
  icon     String @db.VarChar(40)
  url      String @db.Text
  order    Int    @db.Int

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthCredential {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @db.Int
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  tokenType    String   @db.VarChar(20)  // 예: "Bearer"
  expiresIn    DateTime @db.DateTime(0)

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatbotEchoCommand {
  id       Int      @id @default(autoincrement())
  userId   Int
  command  String   @db.VarChar(20)
  response String   @db.Text
  /// 꺼두면 채팅에서 없는 명령어처럼 동작하고 시청자 목록에도 노출되지 않는다 (#82)
  enabled  Boolean  @default(true) @db.TinyInt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatbotFunctionCommand {
  id         Int                  @id @default(autoincrement())
  userId     Int
  permission ChatbotPermission
  command    String               @db.VarChar(20)
  function   String               @db.VarChar(100)
  option     String?              @db.VarChar(20)
  /// 꺼두면 채팅에서 없는 명령어처럼 동작하고 시청자 목록에도 노출되지 않는다 (#82)
  enabled    Boolean              @default(true) @db.TinyInt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatbotRepeat {
  id         Int                  @id @default(autoincrement())
  userId     Int
  response   String               @db.Text
  interval   Int                  @db.Int
  /// 꺼두면 워커가 타이머를 정리해 전송이 멈춘다 (#82)
  enabled    Boolean              @default(true) @db.TinyInt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Song {
  id                 Int      @id @default(autoincrement())
  userId             Int
  youtubeId          String   @db.VarChar(11) // 유튜브 영상 ID
  title              String   @db.VarChar(150) // 영상 제목
  videoUploader      String   @db.VarChar(150) // 영상 게시자
  requester          String   @db.VarChar(40) // 신청자 닉네임 (표시용, 신청 시점 스냅샷)
  requesterChannelId String?  @db.VarChar(32) // 신청자 식별 (닉네임은 변경 가능하므로 판별은 이 값으로)
  durationSeconds    Int      @default(0) @db.Int // 영상 길이(초) — 길이 제한·진행률 표시
  thumbnailUrl       String?  @db.Text
  order              Int      @db.Int // 대기열 순서
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

/// 신청 이력 — 큐에서 사라져도 남는다 (분탕 방지·기록용)
model SongHistory {
  id                 Int               @id @default(autoincrement())
  userId             Int
  youtubeId          String            @db.VarChar(11)
  title              String            @db.VarChar(150)
  videoUploader      String            @db.VarChar(150)
  requester          String            @db.VarChar(40) // 표시용 닉네임
  requesterChannelId String?           @db.VarChar(32)
  durationSeconds    Int               @default(0) @db.Int
  status             SongHistoryStatus
  /// 삭제/스킵을 실행한 사람 (닉네임). 본인 취소면 신청자와 같다
  resolvedBy         String?           @db.VarChar(40)
  /// 스트리머가 이 항목만 시청자에게 숨김
  hiddenFromViewers  Boolean           @default(false) @db.TinyInt
  requestedAt        DateTime          @default(now())
  resolvedAt         DateTime?

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

/// 사이트 전역 설정 (어드민에서 변경) — 예: 신규 가입 시 대표 즐겨찾기로 import 할 유튜브 재생목록 ID
model SiteSetting {
  key       String   @id @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model SongPlayback {
  id            Int        @id @default(autoincrement())
  userId        Int        @unique // 각 유저당 한 개의 재생정보
  status        SongStatus // 재생상태: PLAYING, PAUSED, STOPPED
  youtubeId     String?    @db.VarChar(11) // 유튜브 영상 ID
  title         String?    @db.VarChar(150) // 영상 제목
  videoUploader String?    @db.VarChar(150) // 영상 게시자
  requester     String?    @db.VarChar(40) // 신청자
  durationSeconds Int      @default(0) @db.Int // 현재 곡 길이(초)
  positionSeconds Int      @default(0) @db.Int // 재생 위치(초) — 송출 소스가 보고
  volume        Int        @default(70) @db.Int // 0~100
  /// 한 곡 반복 — 곡이 끝나면 다음 곡으로 넘기지 않고 처음부터 다시 재생한다
  repeatOne     Boolean    @default(false) @db.TinyInt
  /// 현재 곡이 큐에서 나온 시각 — 이력 기록·타임아웃 판단용
  startedAt     DateTime?
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SongFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(50)
  /// 대표 즐겨찾기 — 유저당 최대 1개 (자동 재생의 출처)
  isDefault Boolean  @default(false) @db.TinyInt
  createdAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    SongFavoriteItem[]

  @@index([userId, createdAt])
}

model SongFavoriteItem {
  id              Int    @id @default(autoincrement())
  favoriteId      Int
  youtubeId       String @db.VarChar(11) // 유튜브 영상 ID
  title           String @db.VarChar(150) // 영상 제목
  videoUploader   String @db.VarChar(150) // 영상 게시자
  durationSeconds Int    @default(0) @db.Int // 영상 길이(초)
  order           Int    // 재생목록 내 순서

  favorite      SongFavorite   @relation(fields: [favoriteId], references: [id], onDelete: Cascade)

  @@index([favoriteId, order])
}

/// 네이버 카페 연동 상태 (#9). 봇 계정이 카페 매니저가 되는 과정을 따라간다.
/// 가입은 운영자가 봇 계정으로 직접 한다 — 카페 가입 폼에 보안문자(CAPTCHA)가 있어 자동화할 수 없다 (실측 2026-08-29).
enum CafeLinkStatus {
  NONE
  /// 스트리머가 요청함 → 운영자 가입 대기
  JOIN_REQUESTED
  /// 운영자가 가입 신청을 마침 → 스트리머 승인·스탭 지정 대기
  JOINED
  JOIN_FAILED
  PERMISSION_OK
  PERMISSION_FAILED
  ACTIVE
}

/// 워커에게 시키는 일. 처리하면 null 로 돌아온다
enum CafeAction {
  VERIFY
  /// 대문 HTML 읽어오기 — 스트리머가 삽입 위치를 고르기 위해
  FETCH_GATE
  /// gatePicks 를 대문에 반영
  SAVE_GATE
}

/// 네이버 봇 계정 세션 — 어드민이 관리하는 단일 행 (#9).
/// 환경변수가 아닌 이유: 세션이 만료됐다고 재배포할 수는 없다. 워커는 API(internal)로 받는다.
model NaverBotSession {
  id           Int       @id @default(1)
  /// 스트리머 안내용 (카페에서 승인할 계정 이름)
  displayName  String    @db.VarChar(50)
  nidAut       String    @db.Text
  nidSes       String    @db.Text
  updatedAt    DateTime  @updatedAt @db.DateTime(6)
  /// 워커의 마지막 유효성 검사
  checkedAt    DateTime? @db.DateTime(6)
  valid        Boolean?
  checkMessage String?   @db.VarChar(500)
  /// 만료 알림 메일을 보낸 시각 — 유효로 돌아오면 비운다 (한 번만 보내기 위해)
  alertedAt    DateTime? @db.DateTime(6)
}

/// 스트리머별 카페 연동 (#9). 기본 꺼짐 — 선택 기능이다.
model CafeIntegration {
  id               Int            @id @default(autoincrement())
  userId           Int            @unique
  enabled          Boolean        @default(false)
  cafeUrl          String?        @db.VarChar(200)
  clubId           String?        @db.VarChar(32)
  cafeName         String?        @db.VarChar(100)
  status           CafeLinkStatus @default(NONE)
  statusMessage    String?        @db.VarChar(500)
  pendingAction    CafeAction?
  requestedAt      DateTime?      @db.DateTime(6)
  /// 유튜브 업로드 재생목록 embed — 채널 주소를 해석한 채널 ID(UC…). 크기는 대문에서 고른 영역을 따른다
  youtubeChannelId String?        @db.VarChar(24)
  youtubeTitle     String?        @db.VarChar(100)
  youtubeUrl       String?        @db.VarChar(200)
  /// 대문 이미지 레이아웃 — packages/shared/src/lib/cafeLayout.ts 의 CafeLayout
  layout           Json?
  /// 저장 일련번호. 이미지 URL 의 ?v= 가 되어 네이버 캐시를 무효화한다. 워커가 저장할 때마다 +1
  lastSaveSerial   Int            @default(0)
  /// 마지막 저장 시점의 방송 상태 — 같은 v 는 항상 같은 그림이어야 하므로 렌더는 이걸 그린다
  lastSnapshot     Json?
  /// 갱신 정책용 (#9 PR3b): 마지막 저장 판정 시각·그때의 시청자 구간, 대문에 실제로 써진 일련번호, 마지막 시도 시각
  lastSavedAt      DateTime?      @db.DateTime(6)
  lastViewerBucket Int?
  gateSerial       Int            @default(0)
  saveAttemptedAt  DateTime?      @db.DateTime(6)
  /// 워커가 대문을 실제로 바꾼 마지막 시각 (반영 현황 표시용)
  gateUpdatedAt    DateTime?      @db.DateTime(6)
  /// 워커가 마지막으로 읽어온 대문 HTML — 스트리머가 삽입 위치를 고를 때 렌더한다 (#9 PR3)
  gateHtml         String?        @db.MediumText
  gateFetchedAt    DateTime?      @db.DateTime(6)
  /// 워커가 gateHtml 을 836px 로 렌더한 스크린샷(PNG)과 요소별 좌표 — 콘솔이 네이버와 같은 모양 위에서 자리를 고르게 (#9)
  gateImage        Bytes?         @db.LongBlob
  gateBoxes        Json?
  gateWidth        Int?
  gateHeight       Int?
  /// 스트리머가 고른 자리 — lib/cafeGate.ts 의 GatePicks. 설정이 미완이면 경로만 들고 있다가 완료되면 반영
  gatePicks        Json?
  updatedAt        DateTime       @updatedAt @db.DateTime(6)

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets           CafeAsset[]
}

/// 대문 이미지 배경 (#9 PR2). 파일이 아니라 DB — web(렌더)·api(업로드)가 공유 볼륨 없이 접근한다.
/// 스트리머당 장면(live/offline)별 1장, 2MB 제한.
model CafeAsset {
  id            Int             @id @default(autoincrement())
  integrationId Int
  /// 'live' | 'offline'
  scene         String          @db.VarChar(16)
  mimeType      String          @db.VarChar(64)
  width         Int
  height        Int
  data          Bytes
  createdAt     DateTime        @default(now()) @db.DateTime(6)

  integration   CafeIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, scene])
}